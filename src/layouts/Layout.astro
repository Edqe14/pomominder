---
import '@fontsource/inter';
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<meta name="title" content="Pomominder">
		<meta name="description" content="Manage your productivity.">

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website">
		<meta property="og:url" content="https://pomominder.edqe.me/">
		<meta property="og:title" content="Pomominder">
		<meta property="og:description" content="Manage your productivity.">
		<meta property="og:image" content="/pomo.jpg">

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content="https://pomominder.edqe.me/">
		<meta property="twitter:title" content="Pomominder">
		<meta property="twitter:description" content="Manage your productivity.">
		<meta property="twitter:image" content="/pomo.jpg">

		<title>{title}</title>
	</head>
	<body class="overflow-hidden">
		<main class="w-screen h-screen bg-pale-red transition-colors duration-300 ease-in-out grid place-items-center text-white font-inter">
			<slot />
		</main>
	</body>
</html>

<script>
import { useStore, type Store } from '../lib/store';

// Background updater
const Colors = {
	work: 'bg-pale-red',
	shortBreak: 'bg-pale-teal',
	longBreak: 'bg-pale-blue'
} as const;

const main = document.querySelector('main')!;
// Seeded from the markup, so the class it ships with is removed rather than
// stacked on top of when the mode differs.
let current = Object.values(Colors).find((c) => main.classList.contains(c)) as
	| string
	| undefined;

// The store ticks 4x a second; only touch the DOM when the mode actually changes.
const update = (state: Store) => {
	const next = Colors[state.mode];
	if (next === current) return;

	if (current) main.classList.remove(current);
	main.classList.add(next);
	current = next;
};

update(useStore.getState());
useStore.subscribe(update);
</script>
